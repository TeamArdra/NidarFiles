<?xml version="1.0" encoding="UTF-8"?>
<!-- NIDAR AirMouse test maze, from TeamArdra/gps_denied px4/worlds/nidar_sim.sdf (Rish-736, commit 3d6a49d),
     unchanged. 14 m x 14 m, 2 m corridors, 2.5 m walls, entry gap in the south wall, entry cell at (0, 0).
     Main Mission (Sim) loads it into sim/worlds/nidar_main_mission.sdf; the 2D test sim reads its walls. -->
<sdf version="1.9">
  <world name="nidar_sim">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
